# Cổng lắng nghe (frontend mặc định gọi http://localhost:5000/api)
PORT=5000

# development | production. Production bắt buộc đặt JWT_SIGNING_KEY và CORS_ALLOWED_ORIGINS.
NODE_ENV=development

# Khóa ký JWT, tối thiểu 32 byte. Không dùng lại khóa dev ở môi trường thật.
JWT_SIGNING_KEY=jobboard-development-signing-key-change-before-production-2026
JWT_ISSUER=JobBoard.Api
JWT_AUDIENCE=JobBoard.Web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Danh sách origin được phép gọi API, ngăn cách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# InMemory: dữ liệu seed trong bộ nhớ, mất khi khởi động lại.
# PostgreSql: cần DATABASE_URL (chạy `npm run db:up` để có PostgreSQL ở cổng 5434).
PERSISTENCE_PROVIDER=InMemory
DATABASE_URL=postgres://jobboard:jobboard_dev_password@localhost:5434/jobboard
# true: tự áp migration khi khởi động.
PERSISTENCE_APPLY_MIGRATIONS=false
# Nạp việc làm/công ty và 3 tài khoản demo (mật khẩu công khai) vào bảng còn trống. Mặc định bật ngoài
# production khi áp migration, tắt ở production. Đừng bật cho dữ liệu thật.
# PERSISTENCE_SEED_DEMO_DATA=true
# Quản trị viên đầu tiên (đặt cả hai): chỉ tạo khi áp migration và chưa có quản trị viên nào.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Quản trị viên

# Swagger UI tại /api/docs, tài liệu tại /api/openapi.json (mặc định bật ngoài production).
OPENAPI_ENABLED=true

# Thư mục lưu tệp CV khi dùng PERSISTENCE_PROVIDER=PostgreSql (mặc định ./storage). Nên là ổ đĩa bền vững
# và chỉ tiến trình API được đọc/ghi; provider InMemory giữ tệp trong bộ nhớ.
STORAGE_DIR=./storage

# Địa chỉ frontend để dựng liên kết đặt lại mật khẩu (mặc định: origin CORS đầu tiên). Bắt buộc ở production.
FRONTEND_URL=http://localhost:3000
# Thời hạn liên kết đặt lại mật khẩu, tính bằng phút (1-1440).
PASSWORD_RESET_MINUTES=30

# Log: không gửi email thật, chỉ ghi log (ngoài production có in liên kết đặt lại mật khẩu).
# Smtp: gửi thật, cần SMTP_HOST (và SMTP_USER + SMTP_PASSWORD nếu máy chủ yêu cầu đăng nhập).
EMAIL_PROVIDER=Log
EMAIL_FROM=JobBoard <no-reply@jobboard.vn>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Giới hạn tần suất cho endpoint xác thực (đăng nhập, đăng ký, quên/đặt lại/đổi mật khẩu).
RATE_LIMIT_ENABLED=true
# Proxy được tin để lấy IP thật từ X-Forwarded-For (frontend gọi API từ server nên bắt buộc đúng).
# Dev: loopback. Production: số bước nhảy (1), hoặc IP/CIDR của frontend (vd 10.0.0.0/8,loopback). false = không tin.
TRUST_PROXY=loopback
